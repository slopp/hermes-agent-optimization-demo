# Copy to an untracked local file and insert the *Inference Hub* test key. Do
# not commit credentials to this repository. This variable is deliberately not
# NVIDIA_API_KEY (Build collection) or NVIDIA_INFERENCE_API_KEY (NemoClaw's
# Build-provider onboarding variable).
export INFERENCE_HUB_API_KEY=
export NVIDIA_INFERENCE_ENDPOINT=https://inference-api.nvidia.com/v1/chat/completions
export NVIDIA_INFERENCE_MODEL=nvidia/nvidia/nemotron-3-ultra
# Bound a smoke request; defaults to 45 seconds and accepts 1 through 60.
export NVIDIA_INFERENCE_TIMEOUT=45
