# Copy to a local, untracked .env file and replace the absolute demo path.
# These are local ATOF/ATIF exports for standalone Insights. Intake is optional;
# do not add service credentials here.
export HERMES_NEMO_RELAY_ATOF_ENABLED=1
export HERMES_NEMO_RELAY_ATOF_OUTPUT_DIRECTORY=/ABSOLUTE/PATH/TO/hermes-agent-optimization-demo/.nemo-relay/atof
export HERMES_NEMO_RELAY_ATOF_FILENAME=baseline-events.jsonl
export HERMES_NEMO_RELAY_ATOF_MODE=overwrite

export HERMES_NEMO_RELAY_ATIF_ENABLED=1
export HERMES_NEMO_RELAY_ATIF_OUTPUT_DIRECTORY=/ABSOLUTE/PATH/TO/hermes-agent-optimization-demo/.nemo-relay/atif
export HERMES_NEMO_RELAY_ATIF_FILENAME_TEMPLATE=baseline-trajectory-{session_id}.json
export HERMES_NEMO_RELAY_ATIF_AGENT_NAME=Hermes-PA-style-mock
export HERMES_NEMO_RELAY_ATIF_AGENT_VERSION=REPLACE_WITH_PINNED_REVISION
export HERMES_NEMO_RELAY_ATIF_MODEL_NAME=REPLACE_WITH_PINNED_MODEL_IDENTIFIER
